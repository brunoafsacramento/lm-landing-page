---
// Modelo único de página de serviço (seção 4.3): topo, para quem é, como funciona,
// documentos, preço, prova, perguntas e fecho. O conteúdo vem de data/servicos.ts.
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Faq from './Faq.astro';
import ContactBand from './ContactBand.astro';
import { site } from '../data/site';
import { avulsos, brl } from '../data/precos';
import type { Servico } from '../data/servicos';
import { linkWhatsApp } from '../lib/whatsapp';

interface Props { servico: Servico }
const { servico: s } = Astro.props;
const whatsapp = linkWhatsApp(s.mensagem, s.origem);
const itens = s.precos.map((c) => avulsos[c]);
const menorPreco = itens.length ? Math.min(...itens.map((i) => i.preco)) : null;
const depoimentos = site.depoimentos.filter((d) => d.servico === s.slug);
const url = `${site.url}/${s.slug}`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.menu,
    serviceType: s.menu,
    description: s.descricao,
    url,
    areaServed: 'BR',
    provider: { '@id': `${site.url}/#lm` },
    ...(itens.length && {
      offers: itens.map((i) => ({ '@type': 'Offer', name: i.nome, price: i.preco, priceCurrency: 'BRL', description: `A partir de ${brl(i.preco)}` })),
    }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.perguntas.map((q) => ({ '@type': 'Question', name: q.p, acceptedAnswer: { '@type': 'Answer', text: q.r } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: s.menu, item: url },
    ],
  },
];
---
<Base title={s.titulo} description={s.descricao} mensagem={s.mensagem} origem={s.origem} schema={schema}>
  <section class="service-hero">
    <div class="shell">
      <p class="breadcrumb"><a href="/">Início</a> / {s.menu}</p>
      <div class="service-hero-grid">
        <div>
          <h1>{s.h1}</h1>
          <p class="lead">{s.subtitulo}</p>
          <div class="btn-row">
            <a href={whatsapp} target="_blank" rel="noopener" class="btn btn-whatsapp"><Icon name="whatsapp" /> Conversar no WhatsApp</a>
            <a href="#contato" class="btn btn-outline">Prefiro ser chamado</a>
          </div>
          {site.respostaWhatsApp && <p class="response-note">{site.respostaWhatsApp}</p>}
        </div>
        {menorPreco !== null && (
          <div class="price-box">
            <small>A partir de</small>
            <strong>{brl(menorPreco)}</strong>
            {s.prazo ? <p>Prazo: {s.prazo}</p> : <p>Orçamento fechado antes de começar.</p>}
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <h2>Para quem é</h2>
      <ul class="check-list" style="margin-top:28px">
        {s.paraQuem.map((p) => <li><Icon name="check" size={22} /> {p}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell two-col">
      <div>
        <h2 style="margin-bottom:28px">Como funciona</h2>
        <ol class="steps">{s.comoFunciona.map((p) => <li>{p}</li>)}</ol>
      </div>
      {s.documentos && (
        <div>
          <h2 style="margin-bottom:28px">{s.documentos.titulo}</h2>
          <ul class="doc-list">{s.documentos.itens.map((d) => <li>{d}</li>)}</ul>
        </div>
      )}
    </div>
  </section>

  <slot />

  {itens.length > 0 && (
    <section class="section">
      <div class="shell">
        <div class="section-head"><div><h2>Preço</h2><p>Valores de referência. O orçamento final depende do seu caso e é fechado antes de começar.</p></div></div>
        <div class="price-table">
          {itens.map((i) => (
            <div class="price-row">
              <h3>{i.nome}</h3>
              <p>{i.descricao}</p>
              <div class="price"><small>a partir de</small><strong>{brl(i.preco)}</strong></div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {depoimentos.length > 0 && (
    <section class="section section-alt">
      <div class="shell">
        <h2 style="margin-bottom:28px">Quem já resolveu com a LM</h2>
        <div class="quotes">
          {depoimentos.map((d) => <figure><blockquote>“{d.texto}”</blockquote><figcaption>{d.nome}</figcaption></figure>)}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="narrow">
      <h2 style="margin-bottom:24px">Perguntas frequentes</h2>
      <Faq perguntas={s.perguntas} />
    </div>
  </section>

  <ContactBand whatsapp={whatsapp} origem={s.origem} servico={s.servicoForm} />
</Base>
