---
// Modelo único de página de serviço (seção 4.3): topo, para quem é, como funciona,
// documentos, preço, prova, perguntas, outros serviços e fecho. O conteúdo vem de data/servicos.ts.
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Faq from './Faq.astro';
import ContactBand from './ContactBand.astro';
import { site } from '../data/site';
import { avulsos, planos, brl } from '../data/precos';
import { servicos, type Servico } from '../data/servicos';
import { linkWhatsApp } from '../lib/whatsapp';

interface Props { servico: Servico }
const { servico: s } = Astro.props;
const whatsapp = linkWhatsApp(s.mensagem, s.origem);
const itens = s.precos.map((c) => avulsos[c]).filter(Boolean); // código oculto no portal: não aparece
const menorPreco = itens.length ? Math.min(...itens.map((i) => i.preco)) : null;
const depoimentos = site.depoimentos.filter((d) => d.servico === s.slug);
const url = `${site.url}/${s.slug}`;

// Ferramenta grátis ligada ao serviço, mostrada no topo (quem chega com a dúvida resolve na hora e conversa depois).
const ferramentas: Record<string, { href: string; label: string }> = {
  'imposto-de-renda': { href: '/checklist-imposto-de-renda', label: 'Baixe o checklist de documentos do Imposto de Renda' },
  mei: { href: '/limite-mei', label: 'Calcule se o seu MEI passou do limite' },
  'mei-divida-ativa': { href: '/calendario-de-prazos', label: 'Veja o calendário de prazos do MEI' },
  'abrir-empresa': { href: '/pf-ou-pj#simulador', label: 'Compare PF x PJ no simulador' },
  'pf-ou-pj': { href: '#simulador', label: 'Ir direto para o simulador' },
};
const ferramenta = ferramentas[s.slug];

// Outros serviços: os demais do catálogo + contabilidade mensal.
const menorMensal = planos.some((p) => p.exibir) ? Math.min(...planos.filter((p) => p.exibir).map((p) => p.preco)) : null;
const precoDe = (codigos: string[]) => {
  const v = codigos.map((c) => avulsos[c]?.preco).filter((x): x is number => x !== undefined);
  return v.length ? `a partir de ${brl(Math.min(...v))}` : null;
};
const outros = [
  ...servicos.filter((o) => o.slug !== s.slug).map((o) => ({ href: `/${o.slug}`, nome: o.menu, preco: precoDe(o.precos) })),
  ...(menorMensal !== null ? [{ href: '/contabilidade-mensal', nome: 'Contabilidade mensal', preco: `planos a partir de ${brl(menorMensal)}/mês` }] : []),
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.menu,
    serviceType: s.menu,
    description: s.descricao,
    url,
    areaServed: 'BR',
    provider: { '@id': `${site.url}/#lm` },
    ...(itens.length && {
      offers: itens.map((i) => ({ '@type': 'Offer', name: i.nome, price: i.preco, priceCurrency: 'BRL', description: i.aPartirDe ? `A partir de ${brl(i.preco)}` : brl(i.preco) })),
    }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.perguntas.map((q) => ({ '@type': 'Question', name: q.p, acceptedAnswer: { '@type': 'Answer', text: q.r } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: s.menu, item: url },
    ],
  },
];
---
<Base title={s.titulo} description={s.descricao} mensagem={s.mensagem} origem={s.origem} schema={schema}>
  <section class="service-hero">
    <div class="shell">
      <nav class="breadcrumb" aria-label="Você está em"><a href="/">Início</a> / <span aria-current="page">{s.menu}</span></nav>
      <div class="service-hero-grid">
        <div>
          <h1>{s.h1}</h1>
          <p class="lead">{s.subtitulo}</p>
          <div class="btn-row">
            <a href={whatsapp} target="_blank" rel="noopener" class="btn btn-whatsapp"><Icon name="whatsapp" /> Conversar no WhatsApp</a>
            <a href="#contato" class="btn btn-outline">Prefiro ser chamado</a>
          </div>
          {site.respostaWhatsApp && <p class="response-note">{site.respostaWhatsApp}</p>}
          {ferramenta && <a href={ferramenta.href} class="tool-hint text-link"><Icon name="arrow" size={18} />{ferramenta.label}</a>}
        </div>
        {menorPreco !== null && (
          <div class="price-box">
            {itens.some((i) => i.aPartirDe) && <small>A partir de</small>}
            <strong>{brl(menorPreco)}</strong>
            {s.prazo ? <p>Prazo: {s.prazo}</p> : <p>Orçamento fechado antes de começar.</p>}
            {itens.length > 1 && <a href="#precos">Ver os {itens.length} itens da tabela</a>}
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <h2>Para quem é</h2>
      <ul class="check-list">
        {s.paraQuem.map((p) => <li><Icon name="check" size={22} /> {p}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell two-col">
      <div>
        <h2>Como funciona</h2>
        <ol class="steps">{s.comoFunciona.map((p) => <li>{p}</li>)}</ol>
      </div>
      {s.documentos && (
        <div>
          <h2>{s.documentos.titulo}</h2>
          <ul class="doc-list">{s.documentos.itens.map((d) => <li>{d}</li>)}</ul>
        </div>
      )}
    </div>
  </section>

  <slot />

  {itens.length > 0 && (
    <section class="section" id="precos">
      <div class="shell">
        <div class="section-head"><div><h2>Preço</h2><p>Valores de referência. O orçamento final depende do seu caso e é fechado antes de começar.</p></div></div>
        <div class="price-table">
          {itens.map((i) => (
            <div class="price-row">
              <h3>{i.nome}</h3>
              <p>{i.descricao}{i.prazo && <><br />Prazo: {i.prazo}</>}</p>
              <div class="price">{i.aPartirDe && <small>a partir de</small>}<strong>{brl(i.preco)}</strong></div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {depoimentos.length > 0 && (
    <section class="section section-alt">
      <div class="shell">
        <h2>Quem já resolveu com a LM</h2>
        <div class="quotes">
          {depoimentos.map((d) => <figure><blockquote>“{d.texto}”</blockquote><figcaption>{d.nome}</figcaption></figure>)}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="narrow">
      <h2>Perguntas frequentes</h2>
      <Faq perguntas={s.perguntas} />
    </div>
  </section>

  {outros.length > 0 && (
    <section class="section section-alt" aria-labelledby="outros-titulo">
      <div class="shell">
        <h2 id="outros-titulo">Outros serviços</h2>
        <div class="related">
          {outros.map((o) => <a href={o.href}><strong>{o.nome}</strong>{o.preco && <span>{o.preco}</span>}</a>)}
        </div>
      </div>
    </section>
  )}

  <ContactBand whatsapp={whatsapp} origem={s.origem} servico={s.servicoForm} />
</Base>
