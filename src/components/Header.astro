---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props { path: string; whatsapp: string }
const { path, whatsapp } = Astro.props;

const links = [
  { href: '/imposto-de-renda', label: 'Imposto de Renda' },
  { href: '/mei', label: 'MEI' },
  { href: '/abrir-empresa', label: 'Abrir empresa' },
  { href: '/contabilidade-mensal', label: 'Contabilidade mensal' },
  { href: '/sobre', label: 'Sobre' },
];
---
<header class="site-header">
  <div class="shell header-inner">
    <a href="/" class="brand" aria-label="LM Contabilidade, página inicial"><img src="/logo.png" alt="LM Contabilidade" width="86" height="48" /></a>
    <nav class="main-nav" aria-label="Navegação principal">
      {links.map((l) => <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="header-actions">
      <a href={site.portal} target="_blank" rel="noopener" class="portal-link">Portal do cliente</a>
      <a href={whatsapp} target="_blank" rel="noopener" class="btn btn-whatsapp"><Icon name="whatsapp" size={18} /> WhatsApp</a>
    </div>
    <button class="menu-button" id="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu"><Icon name="menu" size={26} /></button>
  </div>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Menu">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href="/pf-ou-pj">PF ou PJ</a>
    <a href="/imovel-e-doacao">Imóvel e doação</a>
    <a href={site.portal} target="_blank" rel="noopener">Portal do cliente ↗</a>
  </nav>
</header>
