---
import { site, medicao } from '../data/site';
import { servicos } from '../data/servicos';
import { linkWhatsApp, MENSAGEM_HOME } from '../lib/whatsapp';

const temMedicao = Boolean(medicao.ga4 || medicao.googleAds || medicao.metaPixel);
const ano = new Date().getFullYear();
---
<footer>
  <div class="shell footer-grid">
    <div>
      <img src="/logo.png" alt="LM Contabilidade" width="104" height="58" loading="lazy" />
      <p>{site.responsavel} · {site.crc}</p>
      <p>{site.cidade}, {site.uf} · atendimento em todo o Brasil</p>
      <div class="footer-links">
        <a href="/sobre">Sobre a LM</a>
        <a href={site.portal} target="_blank" rel="noopener">Portal do cliente ↗</a>
      </div>
    </div>
    <div>
      <strong>Serviços</strong>
      {servicos.map((s) => <a href={`/${s.slug}`}>{s.menu}</a>)}
      <a href="/contabilidade-mensal">Contabilidade mensal</a>
    </div>
    <div>
      <strong>Ferramentas grátis</strong>
      <a href="/limite-mei">Passei do limite do MEI?</a>
      <a href="/pf-ou-pj#simulador">Simulador PF x PJ</a>
      <a href="/checklist-imposto-de-renda">Checklist do Imposto de Renda</a>
      <a href="/calendario-de-prazos">Calendário de prazos</a>
    </div>
    <div>
      <strong>Contato</strong>
      <a href={linkWhatsApp(MENSAGEM_HOME, 'site-rodape')} target="_blank" rel="noopener">WhatsApp {site.telefoneExibicao}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      {site.horario && <p>{site.horario}</p>}
      {site.instagram && <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>}
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {ano} {site.razaoSocial ?? site.nome}{site.cnpj && ` · CNPJ ${site.cnpj}`}</span>
    <span>
      <a href="/privacidade">Política de privacidade</a>
      {temMedicao && <> · <button type="button" class="linklike" data-abrir-cookies>Preferências de cookies</button></>}
    </span>
  </div>
</footer>
