---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';
import { checklistIr } from '../data/checklist-ir';

const total = checklistIr.reduce((n, g) => n + g.itens.length, 0);
---
<Base
  title="Checklist de documentos do Imposto de Renda (PDF) | LM Contabilidade"
  description={`Lista com os ${total} documentos para separar antes de declarar o Imposto de Renda: rendimentos, despesas dedutíveis, bens e dívidas. Baixe grátis em PDF.`}
  mensagem="Olá! Baixei o checklist do Imposto de Renda e quero ajuda para declarar."
  origem="site-checklist-ir"
>
  <section class="service-hero">
    <div class="shell service-hero-grid" style="align-items:start">
      <div>
        <nav class="breadcrumb" aria-label="Você está em"><a href="/">Início</a> / <a href="/imposto-de-renda">Imposto de Renda</a> / <span aria-current="page">Checklist</span></nav>
        <h1>O que separar para declarar o Imposto de Renda?</h1>
        <p class="lead">A lista completa, em {checklistIr.length} grupos e {total} itens, para imprimir ou salvar em PDF. Deixe seu WhatsApp e a lista abre na hora.</p>
        <ul class="check-list" style="grid-template-columns:1fr">
          {checklistIr.map((g) => <li><Icon name="check" size={22} /> {g.grupo} ({g.itens.length} itens)</li>)}
        </ul>
      </div>
      <LeadForm
        id="checklist"
        origem="site-checklist-ir"
        servico="Imposto de Renda"
        titulo="Receba o checklist"
        botao="Liberar o checklist"
        destino="/checklist-imposto-de-renda/lista"
        mostrarMensagem={false}
      />
    </div>
  </section>
</Base>
