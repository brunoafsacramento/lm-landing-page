---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { checklistIr } from '../../data/checklist-ir';
import { linkWhatsApp } from '../../lib/whatsapp';

const mensagem = 'Olá! Baixei o checklist do Imposto de Renda e quero ajuda para declarar.';
const whatsapp = linkWhatsApp(mensagem, 'site-checklist-ir');
const total = checklistIr.reduce((n, g) => n + g.itens.length, 0);
---
<Base title="Checklist de documentos do Imposto de Renda | LM Contabilidade" description="Lista de documentos para declarar o Imposto de Renda." mensagem={mensagem} origem="site-checklist-ir" noindex>
  <section class="section">
    <div class="narrow">
      <div class="btn-row no-print" style="justify-content:space-between;margin-bottom:28px">
        <a href="/checklist-imposto-de-renda" class="text-link">← Voltar</a>
        <button type="button" class="btn btn-dark" id="salvar-pdf">Salvar em PDF ou imprimir</button>
      </div>
      <img src="/logo.png" alt="LM Contabilidade" width="96" height="54" style="margin-bottom:12px" />
      <h1>Checklist de documentos do Imposto de Renda</h1>
      <p style="margin:12px 0 8px;color:var(--muted)">{total} itens em {checklistIr.length} grupos. Marque o que se aplica a você. Na dúvida, mande assim mesmo: a gente confere.</p>

      {checklistIr.map((g) => (
        <div class="checklist-group">
          <h2>{g.grupo}</h2>
          <ul>
            {g.itens.map((i) => <li><span class="box" aria-hidden="true"></span>{i}</li>)}
          </ul>
        </div>
      ))}

      <p style="margin-top:36px;font-weight:600">{site.nome} · {site.crc} · WhatsApp {site.telefoneExibicao} · {site.url.replace(/^https?:\/\//, '')}</p>
      <div class="no-print" style="margin-top:28px">
        <a href={whatsapp} target="_blank" rel="noopener" class="btn btn-whatsapp"><Icon name="whatsapp" /> Mandar os documentos pelo WhatsApp</a>
      </div>
    </div>
  </section>
</Base>

<script>
  document.getElementById('salvar-pdf')?.addEventListener('click', () => window.print());
  document.addEventListener('DOMContentLoaded', () => {
    try {
      const lead = sessionStorage.getItem('lm_lead');
      if (lead) {
        sessionStorage.removeItem('lm_lead');
        window.lmEvento?.('envio_formulario', JSON.parse(lead));
        window.lmEvento?.('download_checklist');
      }
    } catch { /* armazenamento indisponível */ }
  });
</script>
